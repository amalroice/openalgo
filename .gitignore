# Personal workspace: your own indicators, research, backtests and notes.
# Only the readme is tracked -- everything else is yours and stays local.
# NOTE: gitignore is not a secrecy boundary. `git add -f` bypasses it, and
# the Docker build copies the repo tree, so workspace/ is excluded in
# .dockerignore too. Real secrets belong in .env or keys/, never here.
workspace/**
!workspace/**/
!workspace/readme.md
!workspace/**/readme.md
# Narrow exception, 2026-09-20. The harnesses behind the tables in
# strategies/examples/*2candle* have to ship with them: the original was never
# committed, so those numbers could not be reproduced and had to be rebuilt
# from scratch. A committed result needs its harness in the repo. These are the
# only non-readme files tracked under workspace/ -- keep it that way, and add a
# line here whenever a measurement gets quoted into a committed file.
!workspace/indicators/backtests/nifty_percent_trail_replay.py
!workspace/indicators/backtests/banknifty_percent_trail_replay.py
!workspace/indicators/backtests/twocandle_target_close_stop_replay.py

# Environment files, everywhere and in every variant. Plain `.env` was
# already covered, but `.env.production` / `.env.bak` / `env.backup` were
# not -- `.env.local` only escaped by accidentally matching `*.local`.
# A committed secret must be rotated, not just deleted, so cast wide.
.env.*
*.env
env.backup
!.sample.env
!**/.sample.env
# ...but the negation above must not punch a hole in workspace/, whose
# promise is that only readmes are tracked. Last matching rule wins.
workspace/**/.sample.env

# Local Git worktrees created for isolated feature and documentation work.
.worktrees/
